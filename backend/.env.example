# ============================================================
# Backend environment — TEMPLATE (placeholders only)
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Never commit `.env` or any service-account key file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agri_intelligence

# --- Google Earth Engine (see docs/EARTH_ENGINE_SETUP.md) ---
# Cloud project ID registered for Earth Engine (required).
EE_PROJECT_ID=proverbial-will-507706-e1
EE_SERVICE_ACCOUNT=agricultural-ai@proverbial-will-507706-e1.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=./credentials/gee-key.json

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cache TTL (seconds) ---
CACHE_TTL=3600
