# ============================================================
# Backend environment — TEMPLATE (placeholders only)
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Never commit `.env` or any service-account key file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# Development default; production must inject real credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agri_intelligence

# --- Database connection pool (optional) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- Google Earth Engine (see docs/EARTH_ENGINE_SETUP.md) ---
# Cloud project ID registered for Earth Engine (required for GEE).
EE_PROJECT_ID=your-gcp-project-id
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=credentials/gee-key.json

# --- Redis (optional) ---
REDIS_URL=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Cache TTL (seconds) ---
CACHE_TTL=3600
