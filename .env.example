# ============================================================
# Production compose environment — TEMPLATE (placeholders only)
# Copy to `.env` and fill in real values:
#   cp .env.example .env
# Never commit `.env` or any service-account key file.
# ============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=agri_intelligence

# --- Backend ---
LOG_LEVEL=INFO
# JSON list of allowed origins, e.g. ["https://agri.example.com"]
CORS_ORIGINS=["https://your-domain.example"]
CACHE_TTL=3600

# --- Google Earth Engine (see docs/EARTH_ENGINE_SETUP.md) ---
EE_PROJECT_ID=your-gcp-project-id
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# Path INSIDE the backend container where the key file is mounted
EE_PRIVATE_KEY_FILE=/app/credentials/gee-key.json
# Host directory containing the key file, mounted read-only into the container
EE_KEY_MOUNT_DIR=./backend/credentials

# --- Frontend ---
FRONTEND_PORT=80
